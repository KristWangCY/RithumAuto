{
  "name": "rithum-auto",
  "productName": "RithumAuto",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop automation for Rithum inventory updates",
  "author": "KristWangCY",
  "main": "dist/desktop/main.js",
  "type": "module",
  "scripts": {
    "auth": "npm run build --silent && node dist/auth.js",
    "build": "tsc --outDir dist",
    "check:login": "npm run build --silent && node dist/check-login.js",
    "credentials": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/save-credentials.ps1",
    "desktop": "npm run build --silent && electron .",
    "dist:mac": "npm run build --silent && electron-builder --mac dmg zip --arm64",
    "dist:win": "npm run build --silent && electron-builder --win nsis portable --x64",
    "gui": "npm run build --silent && node dist/gui.js",
    "run": "npm run build --silent && node dist/run.js",
    "run:all": "npm run build --silent && node dist/run-all.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.robotailpets.rithumauto",
    "productName": "RithumAuto",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RithumAuto"
    }
  }
}
