# The first-phase script intentionally handles one SKU per run.
RITHUM_SKU=YOUR-SKU

# Safe by default. A real update additionally requires the --commit CLI flag.
RITHUM_ALLOW_COMMIT=false

RITHUM_INVENTORY_URL=https://app.dsco.io/inventory
RITHUM_PROFILE_DIR=.runtime/rithum-profile
RITHUM_TIMEOUT_MS=30000
RITHUM_VERIFY_TIMEOUT_MS=60000
RITHUM_HEADLESS=true
